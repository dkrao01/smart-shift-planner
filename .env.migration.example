# Local migration-only settings. Copy to .env.migration and keep it untracked.
# Never paste these values into chat or commit this file.

# Path to the Firebase Admin service-account JSON downloaded from Firebase Console.
MIGRATION_FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/firebase-service-account.json

# Supabase project URL from Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase secret service_role key from Project Settings > API.
# This key bypasses RLS. Use only in this local migration script.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Path to JSON mapping Firebase Auth UID -> Supabase Auth UID.
MIGRATION_UID_MAP=/absolute/path/to/supabase-uid-map.json
